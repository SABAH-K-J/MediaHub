# MediaHub Runtime Configuration
# Copy to .env and adjust for your local or containerized environment.

# HTTP Server Binding
MEDIAHUB_HOST=127.0.0.1
MEDIAHUB_PORT=8000

# Persistent Storage Paths (leave unset in dev to use workspace root)
# MEDIAHUB_DB_PATH=/data/library.db
# MEDIAHUB_THUMBNAILS_DIR=/data/thumbnails

# Explicit CORS Allowlist (comma-separated origins, never '*')
MEDIAHUB_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# External Media Tools (executable name on PATH or absolute binary path)
MPV_EXECUTABLE=mpv
FFMPEG_EXECUTABLE=ffmpeg
FFPROBE_EXECUTABLE=ffprobe

# Directory Scanning & Logging
MEDIAHUB_SCAN_MAX_DEPTH=12
MEDIAHUB_LOG_LEVEL=INFO

